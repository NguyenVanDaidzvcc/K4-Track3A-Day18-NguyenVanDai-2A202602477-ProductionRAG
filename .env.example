# cp .env.example .env
# Required for M4 (RAGAS eval) and M5 (Enrichment LLM calls)
OPENAI_API_KEY=sk-...

# Chạy hoàn toàn cục bộ, bỏ qua API và model neural:
RAG_OFFLINE=0
# Mặc định chỉ dùng model đã có trong cache; đặt 1 để cho phép tải model.
RAG_ALLOW_MODEL_DOWNLOAD=0
# Lưu enrichment để những lần chạy sau không gọi lại API cho đoạn không đổi.
RAG_ENRICHMENT_CACHE=1
